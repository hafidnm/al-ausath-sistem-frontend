# ─── API ──────────────────────────────────────────────────────────────────────
# URL backend Laravel. Sesuaikan dengan environment masing-masing.
# Development : http://localhost:8000/api
# Production  : https://api.alausath.sch.id/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# ─── Node Environment ────────────────────────────────────────────────────────
# Gunakan 'development' untuk lokal, 'production' saat deploy ke hosting
NODE_ENV=development
